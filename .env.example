# Copy to .env.local for running on your computer. On Vercel, add these under
# Project → Settings → Environment Variables instead. Never commit real values.

# Login password for the dashboard (required)
APP_PASSWORD=

# Store timezone for daily numbers
STORE_TIMEZONE=America/Los_Angeles

# Shopify — your-store.myshopify.com, plus EITHER an Admin API token OR app client ID + secret
SHOPIFY_STORE_DOMAIN=creep-tee.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Meta Ads — System User token with ads_read; ad account IDs, comma-separated, numbers only
META_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=4271208259789016,3019379334917550

# Printify — personal access token (Printify → Account → Connections)
PRINTIFY_API_TOKEN=
# Optional: pick a specific Printify shop; otherwise the Shopify-connected one is used
PRINTIFY_SHOP_ID=

# TikTok Ads — long-term access token from a TikTok for Business developer app
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_IDS=7599148082336677905,7563858761358753808
